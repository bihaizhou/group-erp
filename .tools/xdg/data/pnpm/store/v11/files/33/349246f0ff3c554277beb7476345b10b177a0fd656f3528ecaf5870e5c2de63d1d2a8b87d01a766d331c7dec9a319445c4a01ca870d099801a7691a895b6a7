{
  "name": "@nocobase/app-plugin-authorization",
  "displayName": "Authorization App Plugin",
  "description": "Authorization integration and permission management UI for NocoBase applications.",
  "version": "1.0.0-beta.27",
  "type": "module",
  "sideEffects": false,
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/plugin": {
      "types": "./dist/client/plugin.d.ts",
      "import": "./dist/client/plugin.js"
    },
    "./client/react-providers": {
      "types": "./dist/client/react-providers.d.ts",
      "import": "./dist/client/react-providers.js"
    },
    "./package.json": "./package.json",
    "./server/extension": {
      "types": "./dist/server/extension/index.d.ts",
      "import": "./dist/server/extension/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@nocobase/app-client": "^3.0.0-beta.1",
    "@nocobase/app-plugin-authentication": "^2.0.0-beta.6",
    "@nocobase/app-server": "^2.0.0-beta.4",
    "@nocobase/db": "^1.0.0-beta.19",
    "@nocobase/i18n": "^1.0.0-beta.7",
    "@nocobase/service-provider": "^0.0.2-beta.2",
    "@nocobase/authorization": "^1.0.0-beta.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.0.0",
    "jsdom": "^30.0.1",
    "knex": "^3.1.0",
    "prettier": "^3.9.6",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@nocobase/app-testing": "0.1.0-beta.3",
    "@nocobase/dev-config": "0.1.0-beta.22",
    "@nocobase/repository-input": "0.1.0-beta.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm test:types",
    "test": "vitest run --passWithNoTests",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-plugin-authorization.tgz\" && pnpm exec publint .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "test:types": "tsc -p tests/tsconfig.json"
  }
}