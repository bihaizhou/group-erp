{
  "name": "@nocobase/app-plugin-notification-in-app",
  "displayName": "In-app Notification App Plugin",
  "description": "Provides an authenticated in-app inbox, notification Channel, and development-only Client inbox page.",
  "version": "1.0.0-beta.24",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "skills"
  ],
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/inbox": {
      "types": "./dist/client/inbox/index.d.ts",
      "import": "./dist/client/inbox/index.js"
    },
    "./client/plugin": {
      "types": "./dist/client/plugin.d.ts",
      "import": "./dist/client/plugin.js"
    },
    "./realtime": {
      "types": "./dist/shared/realtime.d.ts",
      "import": "./dist/shared/realtime.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "hono": "^4.13.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.2.5",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "@nocobase/app-testing": "0.1.0-beta.3",
    "@nocobase/dev-config": "0.1.0-beta.22"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "@nocobase/app-client": "^3.0.0-beta.1",
    "@nocobase/app-plugin-authentication": "^2.0.0-beta.6",
    "@nocobase/app-plugin-notification": "^1.0.0-beta.27",
    "@nocobase/app-server": "^2.0.0-beta.4",
    "@nocobase/db": "^1.0.0-beta.19",
    "@nocobase/i18n": "^1.0.0-beta.7",
    "@nocobase/service-provider": "^0.0.2-beta.2"
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  }
}