{
  "name": "@nocobase/app-plugin-notification",
  "displayName": "Notification App Plugin",
  "description": "Provides the application notification runtime, storage, delivery, and logs.",
  "version": "1.0.0-beta.27",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/plugin": {
      "types": "./dist/client/plugin.d.ts",
      "import": "./dist/client/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "nocobase": {
    "registry": {
      "items": {
        "logs-ui": "./registry/logs-ui"
      }
    },
    "plugin": {
      "database": {
        "migrations": "./database/migrations",
        "seeds": "./database/seeds"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "skills",
    "registry",
    "registry.config.json",
    "public/r"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "hono": "^4.13.2",
    "zod": "^4.6.5",
    "@nocobase/logging": "^0.1.0-beta.7"
  },
  "peerDependencies": {
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@nocobase/app-client": "^3.0.0-beta.1",
    "@nocobase/app-plugin-authentication": "^2.0.0-beta.6",
    "@nocobase/app-plugin-authorization": "^1.0.0-beta.27",
    "@nocobase/app-server": "^2.0.0-beta.4",
    "@nocobase/db": "^1.0.0-beta.19",
    "@nocobase/i18n": "^1.0.0-beta.7",
    "@nocobase/jobs": "^0.1.0-beta.3",
    "@nocobase/service-provider": "^0.0.2-beta.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@nocobase/app-testing": "0.1.0-beta.3",
    "@nocobase/dev-config": "0.1.0-beta.22"
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "registry:build": "node ../../../scripts/registry.mjs build --package .",
    "registry:materialize": "node ../../../scripts/registry.mjs materialize --package .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm registry:build && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  }
}