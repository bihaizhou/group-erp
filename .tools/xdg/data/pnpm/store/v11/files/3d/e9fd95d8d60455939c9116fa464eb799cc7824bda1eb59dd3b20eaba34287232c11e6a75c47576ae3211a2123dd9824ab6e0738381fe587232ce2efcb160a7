{
  "name": "@nocobase/app-plugin-database-explorer",
  "displayName": "Database Explorer",
  "description": "Read-only browsing of an application's database connections, collections, and fields.",
  "version": "1.0.0-beta.15",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/plugin": {
      "types": "./dist/client/plugin.d.ts",
      "import": "./dist/client/plugin.js"
    },
    "./client/database-explorer-client": {
      "types": "./dist/client/database-explorer-client.d.ts",
      "import": "./dist/client/database-explorer-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@nocobase/app-client": "^3.0.0-beta.1",
    "@nocobase/app-plugin-authentication": "^2.0.0-beta.9",
    "@nocobase/app-plugin-authorization": "^1.0.0-beta.27",
    "@nocobase/app-server": "^2.0.0-beta.7",
    "@nocobase/db": "^1.0.0-beta.20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@nocobase/dev-config": "0.1.0-beta.22",
    "@nocobase/service-provider": "0.0.2-beta.2",
    "@nocobase/app-testing": "0.1.0-beta.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  }
}