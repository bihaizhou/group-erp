{
  "name": "@nocobase/app-plugin-users",
  "displayName": "User Management",
  "description": "Reusable user administration APIs and pages for NocoBase applications.",
  "version": "2.0.0-beta.4",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/tokens": {
      "types": "./dist/server/tokens.d.ts",
      "import": "./dist/server/tokens.js"
    },
    "./server/config": {
      "types": "./dist/server/config.d.ts",
      "import": "./dist/server/config.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/plugin": {
      "types": "./dist/client/plugin.d.ts",
      "import": "./dist/client/plugin.js"
    },
    "./client/routes": {
      "types": "./dist/client/routes.d.ts",
      "import": "./dist/client/routes.js"
    },
    "./client/user-client": {
      "types": "./dist/client/user-client.d.ts",
      "import": "./dist/client/user-client.js"
    },
    "./client/preferences": {
      "types": "./dist/client/preferences.d.ts",
      "import": "./dist/client/preferences.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-router": "^7.0.2",
    "@nocobase/app-client": "^3.0.0-beta.1",
    "@nocobase/app-plugin-authentication": "^2.0.0-beta.6",
    "@nocobase/app-plugin-authorization": "^1.0.0-beta.27",
    "@nocobase/app-plugin-notification": "^1.0.0-beta.27",
    "@nocobase/app-server": "^2.0.0-beta.4",
    "@nocobase/authorization": "^1.0.0-beta.13",
    "@nocobase/db": "^1.0.0-beta.19",
    "@nocobase/i18n": "^1.0.0-beta.7",
    "@nocobase/service-provider": "^0.0.2-beta.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-dom": "^19.2.8",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@nocobase/app-testing": "0.1.0-beta.3",
    "@nocobase/dev-config": "0.1.0-beta.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  }
}