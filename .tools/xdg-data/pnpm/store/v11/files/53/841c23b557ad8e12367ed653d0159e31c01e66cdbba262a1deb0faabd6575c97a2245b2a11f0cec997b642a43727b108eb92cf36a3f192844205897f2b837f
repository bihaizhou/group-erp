{
  "name": "@nocobase/authorization",
  "version": "1.0.0-beta.13",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./permission-sets": {
      "types": "./dist/plugins/permission-sets/index.d.ts",
      "import": "./dist/plugins/permission-sets/index.js"
    },
    "./default-access": {
      "types": "./dist/plugins/default-access/index.d.ts",
      "import": "./dist/plugins/default-access/index.js"
    },
    "./sharing-rules": {
      "types": "./dist/plugins/sharing-rules/index.d.ts",
      "import": "./dist/plugins/sharing-rules/index.js"
    },
    "./restriction-rules": {
      "types": "./dist/plugins/restriction-rules/index.d.ts",
      "import": "./dist/plugins/restriction-rules/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@nocobase/dev-config": "0.1.0-beta.22"
  },
  "peerDependencies": {
    "@nocobase/db": "^1.0.0-beta.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  }
}