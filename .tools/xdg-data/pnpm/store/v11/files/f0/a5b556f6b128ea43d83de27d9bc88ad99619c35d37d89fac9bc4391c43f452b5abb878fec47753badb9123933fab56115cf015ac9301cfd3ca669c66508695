{
  "name": "@nocobase/repository-input",
  "version": "0.1.0-beta.3",
  "description": "Portable Repository input contracts and JSON builders for browser and server applications.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/filter-builder": {
      "types": "./dist/filter-builder.d.ts",
      "import": "./dist/filter-builder.js"
    },
    "./internal/select-builder": {
      "types": "./dist/select-builder.d.ts",
      "import": "./dist/select-builder.js"
    },
    "./internal/sort-builder": {
      "types": "./dist/sort-builder.d.ts",
      "import": "./dist/sort-builder.js"
    },
    "./internal/aggregate-builder": {
      "types": "./dist/aggregate-builder.d.ts",
      "import": "./dist/aggregate-builder.js"
    },
    "./internal/relation-mutation-builder": {
      "types": "./dist/relation-mutation-builder.d.ts",
      "import": "./dist/relation-mutation-builder.js"
    },
    "./internal/errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./internal/value-builders": {
      "types": "./dist/value-builders.d.ts",
      "import": "./dist/value-builders.js"
    },
    "./internal/json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@nocobase/dev-config": "0.1.0-beta.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  }
}