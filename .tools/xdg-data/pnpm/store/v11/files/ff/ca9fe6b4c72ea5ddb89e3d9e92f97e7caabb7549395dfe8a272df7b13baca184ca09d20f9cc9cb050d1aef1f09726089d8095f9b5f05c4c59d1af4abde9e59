export function resolveDatabaseCapabilities(overrides = {}) {
    const base = {
        schemas: false,
        views: true,
        replaceView: true,
        materializedViews: false,
        refreshMaterializedViews: false,
        foreignKeys: true,
        deferrableConstraints: false,
        partialIndexes: false,
        nativeTypes: false,
        comments: false,
    };
    return { ...base, ...overrides };
}
