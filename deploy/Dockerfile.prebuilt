# Runtime packaging for hosts without the Docker Buildx plugin. This mirrors
# Dockerfile's prebuilt/runtime contract; it never builds or installs packages.
# Build dist for the destination first and exclude dist/.env from the context.
ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-bookworm-slim
ENV NODE_ENV=production \
    APP_BASE_PATH=/main \
    APP_SERVER_HOST=0.0.0.0 \
    APP_SERVER_PORT=13000 \
    APP_CONFIG_FILE=/app/config.yml
WORKDIR /app
COPY --chown=node:node dist/ ./dist/
COPY config.example.yml ./config.example.yml
RUN node -e 'const p=require("./dist/package.json"),t=p.nocobase?.buildTarget; if(!p.nocobase?.relocatable || t?.platform!==process.platform || t?.arch!==process.arch || t?.libc!=="glibc" || !process.report.getReport().header.glibcVersionRuntime || t?.nodeMajor!==Number(process.versions.node.split(".")[0]) || t?.nodeAbi!==Number(process.versions.modules)) throw new Error("Prebuilt application target does not match the image runtime");' \
    && mkdir -p storage && chown node:node storage
USER node
EXPOSE 13000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch(`http://127.0.0.1:${process.env.APP_SERVER_PORT}${(process.env.APP_BASE_PATH || '').replace(/\\/+$/, '')}/api/healthz`, { signal: AbortSignal.timeout(3000) }).then(async (r) => process.exit(r.ok && (await r.json()).ok === true ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "dist/server/standalone.js"]
